# MySQL connection
# The backend automatically creates ai_text_detector if it does not exist.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_text_detector
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=ai_text_detector

# Frontend / model settings
FRONTEND_ORIGIN=http://localhost:5173
MODEL_NAME=roberta-base-openai-detector
MAX_TEXT_LENGTH=12000
